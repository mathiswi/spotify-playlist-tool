# Required environment variables
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-tunnel.ngrok-free.app

# Spotify API credentials
AUTH_SPOTIFY_ID=your_spotify_client_id
AUTH_SPOTIFY_SECRET=your_spotify_client_secret

# Google Gemini API key for bulk song-list parsing (optional — falls back to
# the deterministic rule parser when unset or on error).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

